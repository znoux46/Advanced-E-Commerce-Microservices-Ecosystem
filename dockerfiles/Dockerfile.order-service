# ================================================================================
# Dockerfile For Order Service (Spring Boot - Java 17)
# ================================================================================
# Build Stage: Compile the application
# ================================================================================
FROM maven:3.9-eclipse-temurin-17 AS build

# Set working directory
WORKDIR /build

# Copy pom.xml and download dependencies first (for layer caching)
COPY src/OrderService/pom.xml ./pom.xml
RUN mvn dependency:go-offline -B

# Copy source files and build
COPY src/OrderService/src ./src
RUN mvn clean package -DskipTests -B

# ================================================================================
# Runtime Stage: Run the application
# ================================================================================
FROM eclipse-temurin:17-jre-alpine AS runtime

# Set working directory
WORKDIR /app

# Create non-root user for security
RUN addgroup -S SpringBoot && adduser -S springuser -G SpringBoot

# Copy jar file from build stage
COPY --from=build /build/target/*.jar app.jar

# Set ownership
RUN chown -R springuser:SpringBoot /app

# Set environment variables
ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC"
ENV SERVER_PORT=8080

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD wget --spider -q http://localhost:8080/actuator/health || exit 1

# Switch to non-root user
USER springuser

# Entry point
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
